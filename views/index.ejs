<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link rel="stylesheet" href="style.css"/>
</head>
<body class="body">
    <%- include("includes/nav.ejs") %>
    <h1 class="heading">MyBlog Posts</h1>
    <% for (let post of posts) { %>
        <div class="container-posts">
            <h2>User: @<%= post.username %></h2>
            <h2>Post: <%= post.content %></h2>
            <button><a href="/posts/<%= post.id %>">See details</a></button>
            <button><a href="/posts/<%= post.id %>/edit">Update Post</a></button> <br> <br>
            <form method="post" action="/posts/<%= post.id %>/?_method=DELETE" >
                <button>Delete</button>
            </form>
        </div>
    <% } %> 
</body>
</html>